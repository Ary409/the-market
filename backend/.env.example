# Opcional: si no se define, el sistema genera una clave segura automáticamente
# y la guarda en backend/.secret_key (recomendado para instalaciones locales).
# SECRET_KEY=pon_aqui_una_clave_larga_y_aleatoria_solo_si_quieres_fijarla

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./inventario.db

# Orígenes permitidos para CORS, separados por coma. "*" = cualquiera.
# Ej: CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:8080
CORS_ORIGINS=*
